    "import os\n",
    "import glob\n",
    "\n",
    "# 找到当前目录下所有 json 文件\n",
    "for file in glob.glob(\"*.json\"):\n",
    "    if \"R1\" in file:  # 只改含有R1的\n",
    "        new_name = file.replace(\"R1\", \"R3\", 1)  # 只替换第一个出现的R1\n",
